{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "europe-west2",
    "rules": ".firebase_config/firestore.rules",
    "indexes": ".firebase_config/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions/isolate",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "cd packages/shared && npm exec tsc && cd ../..",
        "cd functions && npm run build && npm exec isolate && cp .env* ./isolate/ && cd .."
      ]
    }
  ],
  "hosting": {
    "public": "ui/dist",
    "predeploy": [
      "npm --prefix \"ui\" run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/starling/feed-item",
        "function": "starlingFeedItem",
        "region": "europe-west2"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "auth": {
      "port": 9099
    },
    "pubsub": {
      "port": 8085
    },
    "singleProjectMode": true
  }
}